# =============================================================================
# SIGOP-Rueda - Variables de entorno
# Copia este archivo como .env y completa los valores. NUNCA subas el .env.
# En Render las variables se cargan en el panel del servicio (no hay .env).
# Generar claves aleatorias:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# ---- Aplicación --------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Puerto HTTP. Render inyecta PORT automáticamente.
PORT=3000

# ---- SQL Server (paquete mssql) ---------------------------------------------
# Local: localhost (requiere TCP/IP activo y autenticación mixta).
# Azure: <servidor>.database.windows.net
DB_SERVIDOR=localhost
DB_PUERTO=1433
# Solo para instancias con nombre (p. ej. SQLEXPRESS) sin puerto fijo;
# requiere el servicio SQL Server Browser. Si se usa, se ignora DB_PUERTO.
DB_INSTANCIA=
DB_NOMBRE=SIGOP
# Login de SQL Server (no autenticación de Windows).
DB_USUARIO=sigop_app
DB_CLAVE=cambia-esta-clave
# Cifrar la conexión: true en Azure SQL (obligatorio); puede ser true en local.
DB_CIFRAR=true
# Aceptar el certificado autofirmado de SQL Server local: true en local, false en Azure.
DB_CONFIAR_CERTIFICADO=true

# ---- Seguridad ---------------------------------------------------------------
# Clave AES-256-GCM para triaje y PDF: 64 caracteres hexadecimales (32 bytes).
# Si se pierde, los datos cifrados no se pueden recuperar.
CLAVE_CIFRADO=
# Secreto para firmar la sesión (JWT): al menos 32 caracteres.
SECRETO_SESION=

# ---- Correo SMTP (Nodemailer) -----------------------------------------------
# Obligatorias en producción (Render). En desarrollo puedes dejar SMTP_HOST vacío:
# se usa un canal simulado que no envía correos. Si defines SMTP_HOST, completa
# todas las demás. Gmail: smtp.gmail.com, puerto 465, SMTP_SEGURO=true y una
# contraseña de aplicación. Brevo: smtp-relay.brevo.com, 587, false.
SMTP_HOST=
SMTP_PUERTO=465
SMTP_SEGURO=true
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE="Clínica Rueda <no-responder@ejemplo.com>"
