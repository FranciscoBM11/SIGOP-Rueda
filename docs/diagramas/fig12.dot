digraph G { rankdir=TB; nodesep=0.5; ranksep=0.65; fontname="DejaVu Sans"; node [fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans" fontsize=9 color="#333333"];
 pac [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6C8EBF" BGCOLOR="white"><TR><TD BGCOLOR="#DAE8FC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#DAE8FC"><B>Paciente</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cedula: string {readOnly}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ nombres: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ telefono: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ correo: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ creadoEn: Date</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ actualizarContacto(tel, correo): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ get nombreCorto(): string</FONT></TD></TR></TABLE>>];
tur [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6C8EBF" BGCOLOR="white"><TR><TD BGCOLOR="#DAE8FC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#DAE8FC"><B>Turno</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ horarioId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fecha: string (AAAA-MM-DD)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ horaInicio: string (HH:MM)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ horaFin: string (HH:MM)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ habilitado: boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ get duracionMinutos(): number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ estaEnElPasado(ahora: Date): boolean</FONT></TD></TR></TABLE>>];
hor [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D79B00" BGCOLOR="white"><TR><TD BGCOLOR="#FFE6CC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#FFE6CC"><B>HorarioLaboral</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ medicoId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ diaSemana: 1..7</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ horaApertura: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ horaCierre: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ duracionTurno: 30..45</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ activo: boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ validar(): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ generarBloques(fecha): Bloque[]</FONT></TD></TR></TABLE>>];
ser [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6C8EBF" BGCOLOR="white"><TR><TD BGCOLOR="#DAE8FC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#DAE8FC"><B>Servicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ nombre: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ indicacionesPrevias: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ activo: boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ activar(): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ desactivar(): void</FONT></TD></TR></TABLE>>];
cit [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D6B656" BGCOLOR="white"><TR><TD BGCOLOR="#FFF2CC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#FFF2CC"><B>Cita</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ codigo: string {readOnly} (CR-#####)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ pacienteId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ turnoId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ servicioId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ estado: EstadoCita {solo por métodos}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ consentimientoAceptado: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ consentimientoVersion: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ reprogramaciones: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fechaRegistro: Date</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cambiarEstado(nuevo, actor): CambioEstadoCita</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ reprogramar(turno, actor): CambioEstadoCita</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cancelar(actor): CambioEstadoCita</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ get esActiva(): boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ get esModificable(): boolean</FONT></TD></TR></TABLE>>];
est [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="white"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="8">«enumeración»</FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF"><B>EstadoCita</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CONFIRMADA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">EN_ESPERA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ATENDIDA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NO_ASISTIO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CANCELADA</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">(valores fijos)</FONT></TD></TR></TABLE>>];
ess [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6C8EBF" BGCOLOR="white"><TR><TD BGCOLOR="#DAE8FC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#DAE8FC"><B>EstudioSugerido</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ trimestre: 1 | 2 | 3</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ nombre: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ descripcion: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ servicioId?: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ orden: number</FONT></TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
cam [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" BGCOLOR="white"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#F5F5F5"><B>CambioEstadoCita</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ citaId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ estadoAnterior: EstadoCita | null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ estadoNuevo: EstadoCita</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ origen: PACIENTE | PERSONAL | SISTEMA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ usuarioId?: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fechaHora: Date</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ static crear(cita, de, a, actor): CambioEstadoCita</FONT></TD></TR></TABLE>>];
not [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" BGCOLOR="white"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#F5F5F5"><B>Notificacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ citaId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ tipo: CONFIRMACION | REPROGRAMACION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ canal: CORREO | WHATSAPP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ estadoEnvio: PENDIENTE | ENVIADA | FALLIDA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ intentos: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fechaEnvio?: Date</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ marcarEnviada(): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ marcarFallida(error: string): void</FONT></TD></TR></TABLE>>];
int [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" BGCOLOR="white"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#F5F5F5"><B>IntentoAcceso</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cedulaIngresada: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ exitoso: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ipHash?: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fechaHora: Date</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ static registrar(cedula, exitoso, ip): IntentoAcceso</FONT></TD></TR></TABLE>>];
  pac -> cit [arrowhead=none taillabel="1" headlabel="0..*"];
 tur -> cit [arrowhead=none taillabel="1" headlabel="0..*"];
 hor -> tur [arrowhead=none taillabel="1" headlabel="0..*"];
 ser -> cit [arrowhead=none taillabel="1" headlabel="0..*"];
 ser -> ess [arrowhead=none taillabel="0..1" headlabel="0..*"];
 cit -> cam [arrowtail=diamond dir=back taillabel="1" headlabel="0..*"];
 cit -> not [arrowtail=diamond dir=back taillabel="1" headlabel="0..*"];
 cit -> est [style=dashed arrowhead=open label=" usa"];
 cit -> int [style=dashed arrowhead=open label=" «usa» (acceso público)"];
 {rank=same; pac; tur; hor} {rank=same; ser; cit; est} {rank=same; ess; cam; not; int}
}