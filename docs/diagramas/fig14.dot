digraph G { rankdir=TB; nodesep=0.45; ranksep=0.6; fontname="DejaVu Sans"; node [fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans" fontsize=9 color="#333333"];
 rut [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D6B656" BGCOLOR="white"><TR><TD BGCOLOR="#FFF2CC"><FONT POINT-SIZE="8">«rutas»</FONT></TD></TR><TR><TD BGCOLOR="#FFF2CC"><B>citas.routes.js</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">POST /citas · POST /citas/acceso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">POST /citas/:codigo/cancelacion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PATCH /citas/:codigo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">GET /admin/citas/agenda · PATCH .../estado</FONT></TD></TR></TABLE>>];
ctl [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D6B656" BGCOLOR="white"><TR><TD BGCOLOR="#FFF2CC"><FONT POINT-SIZE="8">«controlador (delgado)»</FONT></TD></TR><TR><TD BGCOLOR="#FFF2CC"><B>citas.controller.js</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ crear(req, res)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ acceder(req, res)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cancelar(req, res)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ reprogramar(req, res)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ agenda(req, res)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cambiarEstado(req, res)</FONT></TD></TR></TABLE>>];
sch [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D79B00" BGCOLOR="white"><TR><TD BGCOLOR="#FFE6CC"><FONT POINT-SIZE="8">«validación de entrada»</FONT></TD></TR><TR><TD BGCOLOR="#FFE6CC"><B>citas.schemas.js</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">crearCitaSchema · accesoCitaSchema</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">reprogramarSchema · cambiarEstadoSchema</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">(validan ER-01 a ER-05, RN-05)</FONT></TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
srv [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#82B366" BGCOLOR="white"><TR><TD BGCOLOR="#D5E8D4"><FONT POINT-SIZE="8">«servicio (transacción)»</FONT></TD></TR><TR><TD BGCOLOR="#D5E8D4"><B>CitasService</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- repo: CitasRepository</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- turnos: TurnosService</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- pacientes: PacientesService</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- triaje: TriajeService</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- notificaciones: NotificacionesService</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ agendar(datos): Promise&lt;CitaCreada&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ reprogramar(codigo, turnoId, actor)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cancelar(codigo, actor)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cambiarEstado(codigo, estado, actor)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ agendaDelDia(fecha): Promise&lt;AgendaItem[]&gt;</FONT></TD></TR></TABLE>>];
maq [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#82B366" BGCOLOR="white"><TR><TD BGCOLOR="#D5E8D4"><FONT POINT-SIZE="8">«patrón State»</FONT></TD></TR><TR><TD BGCOLOR="#D5E8D4"><B>MaquinaEstadosCita</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- transiciones: tabla RN-06</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- permisos: tabla RN-11</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ validar(de, a, rol): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ siguientes(estado, rol): EstadoCita[]</FONT></TD></TR></TABLE>>];
gen [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#82B366" BGCOLOR="white"><TR><TD BGCOLOR="#D5E8D4"><FONT POINT-SIZE="8">«utilidad»</FONT></TD></TR><TR><TD BGCOLOR="#D5E8D4"><B>generarCodigoCita()</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ CR-##### aleatorio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ reintenta si hay colisión (RN-02)</FONT></TD></TR></TABLE>>];
rep [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6C8EBF" BGCOLOR="white"><TR><TD BGCOLOR="#DAE8FC"><FONT POINT-SIZE="8">«repositorio (SQL parametrizado)»</FONT></TD></TR><TR><TD BGCOLOR="#DAE8FC"><B>CitasRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- pool: ConnectionPool (mssql)</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ insertar(cita, tx): Promise&lt;number&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ buscarPorCodigo(codigo)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ agendaPorFecha(fecha)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ registrarCambio(cambio, tx)</FONT></TD></TR></TABLE>>];
pre [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" BGCOLOR="white"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="8">«mapper (salida)»</FONT></TD></TR><TR><TD BGCOLOR="#F5F5F5"><B>CitaPresentador</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ aCitaDto(fila): CitaDto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ aAgendaItem(fila): AgendaItemDto (sin triaje)</FONT></TD></TR></TABLE>>];
can [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" BGCOLOR="white"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="8">«interfaz (Strategy)»</FONT></TD></TR><TR><TD BGCOLOR="#F5F5F5"><B>CanalNotificacion</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ enviar(mensaje): Promise&lt;ResultadoEnvio&gt;</FONT></TD></TR></TABLE>>];
cor [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" BGCOLOR="white"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="8">«implementación»</FONT></TD></TR><TR><TD BGCOLOR="#F5F5F5"><B>CanalCorreo</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- transporte: Nodemailer</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ enviar(mensaje)</FONT></TD></TR></TABLE>>];
wha [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" BGCOLOR="white"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="8">«implementación futura»</FONT></TD></TR><TR><TD BGCOLOR="#F5F5F5"><B>CanalWhatsApp</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ enviar(mensaje) (futuro, PB-13)</FONT></TD></TR></TABLE>>];
  rut -> ctl; ctl -> sch [style=dashed arrowhead=open label=" valida"]; ctl -> srv; ctl -> pre [style=dashed arrowhead=open label=" responde con"];
 srv -> maq [style=dashed arrowhead=open label=" valida transiciones"]; srv -> gen [style=dashed arrowhead=open]; srv -> rep; srv -> can [style=dashed arrowhead=open label=" notifica"];
 cor -> can [arrowhead=empty style=dashed]; wha -> can [arrowhead=empty style=dashed];
 {rank=same; ctl; sch; pre} {rank=same; maq; gen; rep; can}  {rank=same; cor; wha}
}