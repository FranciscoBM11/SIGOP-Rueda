digraph G { rankdir=TB; nodesep=0.5; ranksep=0.7; fontname="DejaVu Sans"; node [fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans" fontsize=9 color="#333333"];
 usu [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D79B00" BGCOLOR="white"><TR><TD BGCOLOR="#FFE6CC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#FFE6CC"><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ usuario: string {readOnly}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">- contrasenaHash: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ nombreCompleto: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ rol: MEDICO | RECEPCIONISTA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ intentosFallidos: number (0-5)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ bloqueadoHasta?: Date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ activo: boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ registrarFallo(ahora: Date): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ registrarExito(): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ get estaBloqueado(): boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ verificarClave(clave: string): Promise&lt;boolean&gt;</FONT></TD></TR></TABLE>>];
med [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D79B00" BGCOLOR="white"><TR><TD BGCOLOR="#FFE6CC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#FFE6CC"><B>Medico</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ codigoMinsa: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ especialidad: string</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ puedeMarcarAtendida(): boolean</FONT></TD></TR></TABLE>>];
rec [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D79B00" BGCOLOR="white"><TR><TD BGCOLOR="#FFE6CC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#FFE6CC"><B>Recepcionista</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ turnoLaboral: MATUTINO | VESPERTINO | COMPLETO</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ puedeCargarInformes(): boolean</FONT></TD></TR></TABLE>>];
ses [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#D79B00" BGCOLOR="white"><TR><TD BGCOLOR="#FFE6CC"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#FFE6CC"><B>Sesion</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: string (uuid)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ usuarioId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ creadaEn: Date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ ultimaActividad: Date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ expiraEn: Date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ revocada: boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ get estaVigente(): boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ renovar(ahora: Date): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ revocar(): void</FONT></TD></TR></TABLE>>];
pre [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#82B366" BGCOLOR="white"><TR><TD BGCOLOR="#D5E8D4"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#D5E8D4"><B>PreguntaTriaje</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ servicioId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ texto: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ tipoRespuesta: TEXTO | SI_NO | NUMERO | FECHA | SELECCION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ obligatoria: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ orden: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ activa: boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ validarRespuesta(valor: string): boolean</FONT></TD></TR></TABLE>>];
opc [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#82B366" BGCOLOR="white"><TR><TD BGCOLOR="#D5E8D4"><FONT POINT-SIZE="8">«clase de dominio»</FONT></TD></TR><TR><TD BGCOLOR="#D5E8D4"><B>OpcionPregunta</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ preguntaId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ etiqueta: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ orden: number</FONT></TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
fic [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#82B366" BGCOLOR="white"><TR><TD BGCOLOR="#D5E8D4"><FONT POINT-SIZE="8">«clase de dominio (datos sensibles)»</FONT></TD></TR><TR><TD BGCOLOR="#D5E8D4"><B>FichaTriaje</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ citaId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fechaRegistro: Date</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ agregarRespuesta(pregunta, valor): void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ faltanObligatorias(preguntas): PreguntaTriaje[]</FONT></TD></TR></TABLE>>];
res [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#82B366" BGCOLOR="white"><TR><TD BGCOLOR="#D5E8D4"><FONT POINT-SIZE="8">«clase de dominio (datos sensibles)»</FONT></TD></TR><TR><TD BGCOLOR="#D5E8D4"><B>RespuestaTriaje</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fichaId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ preguntaId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ valor: string (cifrado en la base)</FONT></TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
inf [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6C8EBF" BGCOLOR="white"><TR><TD BGCOLOR="#DAE8FC"><FONT POINT-SIZE="8">«clase de dominio (datos sensibles)»</FONT></TD></TR><TR><TD BGCOLOR="#DAE8FC"><B>InformeResultado</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ id: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ citaId: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ cargadoPor: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ nombreArchivo: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ tamanoBytes: number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ hashSha256: string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ fechaCarga: Date</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ get tamanoMB(): number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">+ verificarIntegridad(buffer): boolean</FONT></TD></TR></TABLE>>];
  usu -> med [arrowhead=empty dir=back arrowtail=empty label=" 1 a 0..1"];
 usu -> rec [arrowhead=empty dir=back arrowtail=empty];
 usu -> ses [arrowhead=none taillabel="1" headlabel="0..*"];
 pre -> opc [arrowtail=diamond dir=back taillabel="1" headlabel="0..*"];
 fic -> res [arrowtail=diamond dir=back taillabel="1" headlabel="1..*"];
 pre -> res [arrowhead=none taillabel="1" headlabel="0..*"];
 rec -> inf [arrowhead=none taillabel="1" headlabel="0..*"];
 {rank=same; usu; pre; fic} {rank=same; med; rec; opc; res} {rank=same; ses; inf}
}